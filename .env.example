# ============================================================
# BestWrinkleReducers.com — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# --- Amazon Associates ---
# Your Amazon Associates tracking tag (e.g. bestwrinkle-20)
NEXT_PUBLIC_AMAZON_TAG=YOURTAG-20

# --- AWIN Affiliate ---
# Your AWIN publisher ID
NEXT_PUBLIC_AWIN_PUBLISHER_ID=YOUR_AWIN_ID

# --- Google AdSense ---
# Your AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# --- Site URL (used for sitemap & OG tags) ---
NEXT_PUBLIC_SITE_URL=https://www.bestwrinklereducers.com

# --- Google Analytics 4 (optional) ---
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
